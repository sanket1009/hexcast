# =============================================================================
# CHBIndex — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your actual values:
#     cp .env.example .env
#
# NEVER commit .env to version control — it contains real credentials.
# .env is already in .gitignore. .env.example is safe to commit.
#
# Each section below explains what the variable is, where to get it,
# and what happens if it is missing.
# =============================================================================


# -----------------------------------------------------------------------------
# ANTHROPIC API
# Used by: src/rag/briefing.py
# Purpose: Calls Claude API to generate plain-English risk briefings
#          for high-risk census tracts each week.
# How to get: https://console.anthropic.com → API Keys → Create Key
# Missing: RAG briefing generation will fail. All other pipeline
#          stages (ingestion, spatial, ML) will still run normally.
# -----------------------------------------------------------------------------

ANTHROPIC_API_KEY=your_anthropic_api_key_here


# -----------------------------------------------------------------------------
# GOOGLE CLOUD PLATFORM
# Used by: src/utils/bigquery.py, src/utils/gcs.py, src/ingestion/gee_lst.py
# Purpose: Authenticates all GCP services — BigQuery, GCS, Earth Engine.
# How to get:
#   1. Go to console.cloud.google.com
#   2. Create a project (or use existing)
#   3. IAM & Admin → Service Accounts → Create Service Account
#   4. Grant roles: BigQuery Admin, Storage Admin
#   5. Keys → Add Key → JSON → Download
#   6. Save the JSON file somewhere safe (NOT inside this repo)
#   7. Set GCP_SERVICE_ACCOUNT_PATH to the absolute path of that JSON file
# Missing: BigQuery writes and GCS uploads will fail entirely.
# -----------------------------------------------------------------------------

GCP_PROJECT_ID=your_gcp_project_id_here
GCP_SERVICE_ACCOUNT_PATH=/absolute/path/to/your/service-account-key.json


# -----------------------------------------------------------------------------
# GOOGLE EARTH ENGINE
# Used by: src/ingestion/gee_lst.py
# Purpose: Authenticates GEE Python API to pull Landsat 9 LST rasters.
#
# GEE uses a separate authentication from standard GCP even though both
# are Google products. You need a GEE-specific service account registered
# with Earth Engine access.
#
# How to get:
#   1. Go to https://signup.earthengine.google.com — register for access
#      (free for research/non-commercial use — approval takes 1-3 days)
#   2. Once approved, go to https://code.earthengine.google.com
#   3. In your GCP project, create a service account and register it:
#      earthengine authenticate --service_account_file=path/to/key.json
#   4. Set GEE_SERVICE_ACCOUNT to the service account email
#   5. Set GEE_PRIVATE_KEY_PATH to the JSON key file path
#
# Alternative (easier for development):
#   Run: earthengine authenticate
#   This opens a browser, you log in with your Google account, and GEE
#   stores credentials locally. You don't need these two variables if
#   you use browser-based auth during development.
#
# Missing: LST satellite data ingestion will fail. Heat signal will be
#          unavailable — compound score cannot be computed.
# -----------------------------------------------------------------------------

GEE_PROJECT_ID=your-earth-engine-cloud-project-id
GEE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=/absolute/path/to/your/gee-private-key.json


# -----------------------------------------------------------------------------
# EPA AQS API
# Used by: src/ingestion/epa_aqs.py
# Purpose: Authenticates requests to the EPA Air Quality System API
#          to pull daily PM2.5 monitor readings.
#
# How to get:
#   1. Go to https://aqs.epa.gov/data/api/signup
#   2. Enter your email — EPA emails you a key within minutes
#   3. The key is just your email address used as an API token
#
# Note: The EPA AQS API works without a key but rate limits unauthenticated
#       requests heavily. With a key you get higher limits.
#       Your email address IS the key — set both variables to your email.
#
# Missing: PM2.5 ingestion will hit rate limits but not fail completely.
#          Pipeline will be slower but functional for development.
# -----------------------------------------------------------------------------

EPA_AQS_EMAIL=your_email@example.com
EPA_AQS_KEY=your_email@example.com


# -----------------------------------------------------------------------------
# CENSUS DATA API
# Used by: src/ingestion/census_tiger.py
# Purpose: Pulls ACS 5-year population and median income per tract.
# How to get: https://api.census.gov/data/key_signup.html (free, emailed;
#             click the activation link before first use)
# Missing: Tract ingestion stops with a clear error. The API rejects
#          keyless requests.
# -----------------------------------------------------------------------------

CENSUS_API_KEY=your-census-api-key-here


# -----------------------------------------------------------------------------
# CDC PLACES API (SOCRATA)
# Used by: src/ingestion/cdc_places.py
# Purpose: App token for CDC PLACES Socrata API — increases rate limits
#          from 1000 to 50000 requests per hour.
#
# How to get:
#   1. Go to https://data.cdc.gov
#   2. Sign in or create a free account
#   3. Developer Settings → Create New App Token
#   4. Name it "CHBIndex" → Copy the app token
#
# Missing: CDC PLACES ingestion still works without this token but
#          rate limits apply. For development with one city this is fine.
#          For production with multiple cities, the token is required.
# -----------------------------------------------------------------------------

CDC_SOCRATA_APP_TOKEN=your_cdc_socrata_app_token_here


# -----------------------------------------------------------------------------
# AIRFLOW
# Used by: docker/docker-compose.yml, airflow/dags/
# Purpose: Airflow requires a secret key to sign web session cookies
#          and encrypt sensitive values in the metadata database.
#
# How to generate a secure key:
#   Run this in your terminal:
#   python -c "import secrets; print(secrets.token_hex(32))"
#   Copy the output and paste it below.
#
# Missing: Airflow will not start. This is required.
# -----------------------------------------------------------------------------

AIRFLOW_SECRET_KEY=generate_a_random_hex_string_with_python_secrets_module
AIRFLOW_FERNET_KEY=generate_a_fernet_key_with_cryptography_library


# -----------------------------------------------------------------------------
# MLFLOW
# Used by: src/ml/train.py, src/ml/evaluate.py
# Purpose: MLflow tracking server URI. During local development this
#          points to the local mlruns/ folder. In production it would
#          point to a remote MLflow server.
#
# For local development: leave this as the default below.
# For production: set to your remote MLflow server URL.
#
# Missing: MLflow falls back to local ./mlruns directory automatically.
#          This variable is optional — default behavior is correct for dev.
# -----------------------------------------------------------------------------

MLFLOW_TRACKING_URI=mlflow/mlruns