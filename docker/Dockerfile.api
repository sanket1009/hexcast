# =============================================================================
# CHBIndex — FastAPI Container
# =============================================================================
# Serves the compound burden scores and LLM briefings via REST API.
# Deployed to GCP Cloud Run for public access.
#
# Build:  docker build -f docker/Dockerfile.api -t chbindex-api .
# Run:    docker run -p 8000:8000 chbindex-api
# Docs:   http://localhost:8000/docs (Swagger UI auto-generated by FastAPI)
# =============================================================================

# Python 3.12 slim — minimal base image
# 'slim' variant strips out unnecessary system packages
# Result: much smaller image than the full Python image
# Full python:3.12 = ~1GB, python:3.12-slim = ~130MB
FROM python:3.12-slim

# Set working directory inside the container
# All subsequent commands run from this directory
WORKDIR /app

# Install system dependencies
# Only what FastAPI actually needs — much less than Airflow
#
# curl     — used by the Cloud Run health check endpoint
# gcc      — needed to compile some Python C extensions
#
# Same pattern as Dockerfile.airflow:
# install → clean up package cache → keep image small
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy only what the API needs
# We copy requirements first, install, THEN copy source code.
# Why this order? Docker builds images in layers. Each instruction
# is one layer. If requirements.txt hasn't changed, Docker reuses
# the cached pip install layer — much faster rebuilds.
# If we copied src/ first, any code change would invalidate the
# pip install cache and reinstall everything from scratch every time.
COPY docker/requirements-api.txt /app/requirements-api.txt

# Install Python dependencies
RUN pip install --no-cache-dir -r /app/requirements-api.txt

# Copy source code into container
# src/serving/ contains api.py and schemas.py
# src/utils/ contains config_loader.py and bigquery.py
# config/ contains the city YAML files the API reads
COPY src/ /app/src/
COPY config/ /app/config/

# Set Python path so imports work correctly
# from src.serving.api import app  ← needs /app in PYTHONPATH
ENV PYTHONPATH="/app:${PYTHONPATH}"

# Tell Python not to write .pyc bytecode files
# Not needed in a container — saves disk space
ENV PYTHONDONTWRITEBYTECODE=1

# Tell Python not to buffer stdout/stderr
# Without this, print() statements don't appear in docker logs
# immediately — they get buffered and appear in batches
ENV PYTHONUNBUFFERED=1

# Expose port 8000 — the port FastAPI listens on
# This is documentation only — it doesn't actually open the port
# The actual port mapping happens in docker-compose or Cloud Run config
EXPOSE 8000

# Health check — Cloud Run uses this to know if the container is ready
# Calls /health endpoint every 30 seconds
# If it fails 3 times in a row, Cloud Run restarts the container
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Start the FastAPI application
# uvicorn: the ASGI server that runs FastAPI
# src.serving.api:app — the FastAPI app object in src/serving/api.py
# --host 0.0.0.0 — listen on all network interfaces
#                   without this, only localhost can reach it
#                   inside a container, 0.0.0.0 is required
# --port 8000 — the port to listen on
# --workers 2 — two parallel worker processes
#               handles two simultaneous requests without blocking
#               on M4 Pro or Cloud Run with 2 vCPUs this is appropriate
CMD ["uvicorn", "src.serving.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]